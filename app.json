{
  "expo": {
    "name": "Muscle Lab",
    "slug": "muscle-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111B28",
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "monochromeImage": "./assets/icon/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joffreribeiro.musclelab"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#14A8A8",
          "defaultChannel": "descanso"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/icon/favicon.png"
    }
  }
}
