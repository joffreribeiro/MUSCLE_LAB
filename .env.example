# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → app Web → "Configuração do SDK").
# Estas chaves são públicas por desenho; os dados ficam protegidos pelas regras em firebase/firestore.rules.
# Sem estas variáveis o app abre direto, sem login e sem sincronização.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Deixe fora (ou 0) para esconder "Criar conta"; as contas são criadas no console do Firebase.
# EXPO_PUBLIC_FIREBASE_ALLOW_SIGNUP=1
