# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase
# (Project Settings -> API). A chave "anon" é pública por desenho; os dados ficam
# protegidos pelas regras de acesso criadas em supabase/schema.sql.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
